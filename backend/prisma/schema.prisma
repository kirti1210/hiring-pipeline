generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  RECRUITER
  INTERVIEWER
  CANDIDATE
}

enum JobStatus {
  DRAFT
  OPEN
  ON_HOLD
  CLOSED
}

enum ApplicationStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum ApplicationEventType {
  APPLICATION_CREATED
  STAGE_CHANGED
  INTERVIEW_SCHEDULED
  FEEDBACK_SUBMITTED
  NOTE_ADDED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdJobs          Job[]                    @relation("JobCreator")
  applications         Application[]            @relation("CandidateApplications")
  interviewAssignments ApplicationInterviewer[]
  applicationEvents    ApplicationEvent[]       @relation("EventActor")
  feedback             Feedback[]
  alertDismissals      AlertDismissal[]
}

model Job {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  description String?
  status      JobStatus @default(DRAFT)
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isArchived  Boolean   @default(false)

  createdBy    User          @relation("JobCreator", fields: [createdById], references: [id])
  applications Application[]

  @@index([status])
  @@index([createdById])
  @@index([isArchived])
}

model Application {
  id          String           @id @default(uuid()) @db.Uuid
  jobId       String           @db.Uuid
  candidateId String           @db.Uuid
  stage       ApplicationStage @default(APPLIED)
  source      String?
  notes       String?
  appliedAt   DateTime         @default(now())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  job          Job                      @relation(fields: [jobId], references: [id])
  candidate    User                     @relation("CandidateApplications", fields: [candidateId], references: [id])
  interviewers ApplicationInterviewer[]
  events       ApplicationEvent[]
  feedback     Feedback[]

  @@unique([jobId, candidateId])
  @@index([jobId])
  @@index([candidateId])
  @@index([stage])
}

model ApplicationInterviewer {
  applicationId String   @db.Uuid
  interviewerId String   @db.Uuid
  assignedAt    DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewer User        @relation(fields: [interviewerId], references: [id])

  @@id([applicationId, interviewerId])
  @@index([interviewerId])
}

model ApplicationEvent {
  id            String               @id @default(uuid()) @db.Uuid
  applicationId String               @db.Uuid
  actorId       String?              @db.Uuid
  type          ApplicationEventType
  description   String?
  createdAt     DateTime             @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor       User?       @relation("EventActor", fields: [actorId], references: [id])

  @@index([applicationId])
  @@index([actorId])
  @@index([type])
}

model Feedback {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @db.Uuid
  interviewerId String   @db.Uuid
  rating        Int
  comments      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewer User        @relation(fields: [interviewerId], references: [id])

  @@unique([applicationId, interviewerId])
  @@index([applicationId])
  @@index([interviewerId])
}

model AlertDismissal {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
